# ---------------------------------------------------------------------------
# Gemini — powers the AI Insights tab only.
#
# Everything else works without it: your investor segment, the portfolio
# allocation and the gold forecast are computed locally by the trained models.
# Without a key the planner falls back to an answer written from your profile,
# and the UI says so rather than failing.
#
# Copy this file to .env and put your key there — .env is gitignored.
# This file is committed, so it must never contain a real key.
# Get one free at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Chat model used by the planning agents.
GEMINI_MODEL=models/gemini-flash-latest

# Embedding model for retrieval. The committed FAISS index was built with this
# one, and an index can only be queried by the model that built it. If you
# change this, rebuild: python -m training.build_index
EMBED_MODEL=models/gemini-embedding-001
