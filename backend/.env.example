# SQLite by default — no database to install. For MySQL:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/finplan
DATABASE_URL=

# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001

LLM_TIMEOUT_SECONDS=25

# Gemini key for the AI Insights tab. Optional — every model prediction works
# without it. The backend reads it from here or from ml/.env.
GEMINI_API_KEY=
